FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy

WORKDIR /srv/onecost

RUN apt-get update && apt-get install -y xvfb dos2unix && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /srv/onecost/requirements.txt
RUN pip install --no-cache-dir -r /srv/onecost/requirements.txt

COPY ./robot /srv/onecost/robot
COPY robot_entrypoint.sh /srv/onecost/robot_entrypoint.sh

RUN dos2unix /srv/onecost/robot_entrypoint.sh && chmod +x /srv/onecost/robot_entrypoint.sh
RUN test -f /srv/onecost/robot/main.py && test -f /srv/onecost/robot_entrypoint.sh

ENV APP_DIR=/srv/onecost
ENV PYTHONPATH=/srv/onecost/robot
ENV PYTHONUNBUFFERED=1

CMD ["/srv/onecost/robot_entrypoint.sh"]
