FROM python:3.9-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

RUN test -f /app/server.py && test -f /app/bootstrap.py

ENV APP_DIR=/app
ENV COMPROVANTES_STATIC_DIR=/app/static/comprovantes

CMD ["sh", "-lc", "python /app/bootstrap.py && exec uvicorn server:app --host 0.0.0.0 --port 8000"]
